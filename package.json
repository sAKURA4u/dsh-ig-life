{
  "name": "dsh-ig-life",
  "version": "0.3.0",
  "description": "把 DeepSeek 養進 Instagram —— a DSH bundle that gives an agent an Instagram life: DM bridge, plastic memory, daily rhythm, and its own diary posts.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "lib",
    "src",
    "persona",
    "presets",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "self-check": "node scripts/self-check.mjs",
    "link-dsh": "node scripts/link-dsh.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "instagram",
    "ai-companion",
    "memory"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sAKURA4u/dsh-ig-life.git"
  },
  "homepage": "https://github.com/sAKURA4u/dsh-ig-life#readme",
  "bugs": {
    "url": "https://github.com/sAKURA4u/dsh-ig-life/issues"
  },
  "author": "sAKURA4u"
}
